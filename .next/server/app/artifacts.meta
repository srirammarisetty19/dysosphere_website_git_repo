{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/artifacts/layout,_N_T_/(app)/artifacts/page,_N_T_/artifacts"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/artifacts/__PAGE__",
    "/!KGFwcCk/artifacts",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}